DO $$
BEGIN
    BEGIN
        INSERT INTO virginia_dev_saayam_rdbms.organizations
            (org_name, org_type, org_size, is_contributing)
        VALUES ('TEST_SEMANTIC_VIOLATION', 'non_profit', 'small', TRUE);
        RAISE EXCEPTION 'T8: chk_contributing_only_for_profit not enforced.';
